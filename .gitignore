# ==========================================
# 1. Machine Learning Models
# ==========================================
# Ignore serialized model files to avoid bloating the repository
models/*
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx

# ==========================================
# 2. Python Caches & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# 3. Configuration & Secrets
# ==========================================
# Ignore local environment variables and sensitive system thresholds
.env
.env.local

# ==========================================
# 4. IDEs & OS Junk
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db